PRIVKEY="my_priv_key"
SIGNETCHALLENGE="my_signet_challenge"
EXTERNAL_IP="127.0.0.1"

NBITS="1e0377ae" # min difficulty
BLOCKPRODUCTIONDELAY=30

UACOMMENT="MutinyNet"

RPCPASSWORD="my_rpc_password"

NSEC="my-nsec"

MINT_PRIVATE_KEY="my_mint_priv_key"

JWT_SECRET="my_jwt_secret"
GITHUB_CLIENT_ID="my_github_client_id"
GITHUB_CLIENT_SECRET="my_github_client_secret"
CF_TOKEN="my_cloudflare_token"
ANALYTICS_TOKEN="my_analytics_token"
ADMIN_TOKEN="my_admin_token"  # separate from ANALYTICS_TOKEN, guards faucet admin API
L402_ROOT_KEY="my_l402_root_key"
MAINNET_GRPC_HOST="mainnet_lnd_host"

ARKADE_MNEMONIC="my_arkade_mnemonic"
ARKADE_FAUCET_TOKEN="my_arkade_faucet_token"
ARKADE_INTERNAL_TOKEN="my_arkade_internal_token"

POSTGRES_PASSWORD="my_postgres_password"
MYSQL_PASSWORD="my_mysql_password"
MYSQL_ROOT_PASSWORD="my_mysql_root_password"
# --- Spark / SSP (self-hosted) ---
# Published SSP images. Pin these to a tested release or sha-* tag in
# production instead of relying on latest.
SSP_IMAGE="ghcr.io/benthecarman/mutinynet-ssp:latest"
SIDECAR_IMAGE="ghcr.io/benthecarman/mutinynet-ssp-sidecar:latest"
# Shared secret between SSP and swap sidecar (generate: openssl rand -hex 32).
SIDECAR_TOKEN="my_sidecar_token"
# Browser origins allowed to call the SSP, separated by commas.
SSP_CORS_ORIGINS="https://mutinynet.com"
# Add both lines from ./spark-operator-pubkeys.sh after first SO boot.
SO_IDENTITY_PUBKEYS=""
SSP_FROST_OPERATORS=""
SSP_RUST_LOG="info"
# bitcoind wallet used to fund the sidecar (must exist + hold funds).
BITCOIN_RPC_WALLET="default"
ELECTRS_URL="http://mempool_electrs:3003"
# Optional liquidity ladder overrides.
FUND_LADDER="1000,2000,4000,8000,16000,32000,64000"
FUND_MULTIPLICITY=20
