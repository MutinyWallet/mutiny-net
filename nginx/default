# Catch-all for requests to the bare IP or to a host with no vhost.
# Without it, nginx answers them with the first vhost on port 80.
server {
	listen 80 default_server;
	listen [::]:80 default_server;
	server_name _;

	root /root/mutiny-net/nginx/static;
	error_page 404 /404.html;

	location = /404.html {
		internal;
	}

	location / {
		return 404;
	}
}
